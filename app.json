{
  "expo": {
    "name": "Adugbo",
    "slug": "adugbo",
    "scheme": "adugbo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adugbo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF7FF"
      },
      "package": "com.adugbo.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Adugbo uses the camera to scan visitor QR codes at the gate."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}