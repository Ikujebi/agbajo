{
  "expo": {
    "name": "Agbajo",
    "slug": "agbajo",
    "scheme": "agbajo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Agbajo uses the camera to scan visitor QR codes at the gate." }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
